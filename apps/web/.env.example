# Banco de dados (Supabase → Project Settings → Database → Transaction pooler, porta 6543).
# Deixe vazio para usar o Postgres embutido com dados de demonstração.
DATABASE_URL=""

# Segredo da sessão (obrigatório com DATABASE_URL). Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Domínio raiz (subdomínios = app do aluno de cada personal) e URL pública do app
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Asaas (cobrança automática) — sandbox até o piloto
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_PLATFORM_WALLET_ID=""
ASAAS_WEBHOOK_TOKEN=""
