// Modelo de dados do MVP — multi-tenant por tenantId.
// Valores monetários em centavos (Int) para evitar erro de arredondamento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Plataforma / Tenant ─────────────

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique // subdomínio: felipe.dominio.com.br
  name         String   // nome do negócio / app exibido ao aluno
  // Marca (white label)
  logoUrl      String?
  iconUrl      String?
  primaryColor String   @default("#111827")
  accentColor  String   @default("#22C55E")
  fontFamily   String?
  // Pagamentos
  paymentsEnabled      Boolean @default(false)
  providerAccountId    String? // id da subconta no gateway (Asaas)
  providerWalletId     String? // walletId usado no split
  feePassThrough       Boolean @default(false) // repassa taxas ao aluno?
  platformFeeBps       Int     @default(150)   // 150 = 1,50%
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains        TenantDomain[]
  memberships    Membership[]
  students       Student[]
  plans          Plan[]
  subscriptions  StudentSubscription[]
  invoices       Invoice[]
  ledgerEntries  LedgerEntry[]
  sessions       ClassSession[]
  exercises      Exercise[]
  workouts       Workout[]
  assessments    Assessment[]
  platformSub    PlatformSubscription?
}

model TenantDomain {
  id        String  @id @default(cuid())
  tenantId  String
  domain    String  @unique // app.felipeastur.com.br (futuro)
  verified  Boolean @default(false)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum PlatformPlanTier {
  START
  PRO
  STUDIO
}

enum PlatformSubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// Assinatura SaaS que o personal paga à plataforma
model PlatformSubscription {
  id                String            @id @default(cuid())
  tenantId          String            @unique
  tier              PlatformPlanTier  @default(START)
  status            PlatformSubStatus @default(TRIALING)
  priceCents        Int
  trialEndsAt       DateTime?
  providerSubId     String?
  currentPeriodEnd  DateTime?
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ───────────── Usuários e acesso ─────────────

enum Role {
  PLATFORM_ADMIN
  OWNER    // personal dono do tenant
  TRAINER  // professor auxiliar (plano Studio)
  STUDENT
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  phone         String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  memberships   Membership[]
}

model Membership {
  id        String @id @default(cuid())
  userId    String
  tenantId  String
  role      Role
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

// ───────────── Alunos e planos ─────────────

enum StudentStatus {
  INVITED
  ACTIVE
  PAUSED
  INACTIVE
}

model Student {
  id                 String        @id @default(cuid())
  tenantId           String
  userId             String?       // preenchido quando o aluno aceita o convite
  name               String
  email              String?
  phone              String?
  birthDate          DateTime?
  status             StudentStatus @default(INVITED)
  notes              String?
  providerCustomerId String?       // cliente no gateway
  healthDataConsentAt DateTime?    // consentimento LGPD para dados de saúde
  createdAt          DateTime      @default(now())
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscriptions StudentSubscription[]
  invoices      Invoice[]
  attendances   Attendance[]
  workouts      Workout[]
  assessments   Assessment[]

  @@index([tenantId, status])
}

enum PlanType {
  RECURRING  // mensal, trimestral...
  PACKAGE    // pacote de N aulas
  SINGLE     // aula avulsa
  ONLINE     // consultoria online
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

model Plan {
  id               String           @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  type             PlanType
  priceCents       Int
  interval         BillingInterval? // só RECURRING/ONLINE
  sessionsPerWeek  Int?
  sessionsTotal    Int?             // só PACKAGE
  validityDays     Int?             // validade do pacote
  dueDay           Int?             // dia de vencimento padrão
  discountPct      Int?             // desconto em %
  lateFeePct       Int?             // multa por atraso
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions    StudentSubscription[]

  @@index([tenantId, active])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

model StudentSubscription {
  id             String             @id @default(cuid())
  tenantId       String
  studentId      String
  planId         String
  status         SubscriptionStatus @default(ACTIVE)
  priceCents     Int                // preço congelado na contratação
  startDate      DateTime
  endDate        DateTime?
  sessionsLeft   Int?               // controle de pacotes
  providerSubId  String?            // assinatura recorrente no gateway
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
  invoices       Invoice[]

  @@index([tenantId, studentId])
}

// ───────────── Cobrança e financeiro ─────────────

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  CASH       // recebido fora do app (lançamento manual)
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

model Invoice {
  id                String         @id @default(cuid())
  tenantId          String
  studentId         String
  subscriptionId    String?
  description       String
  amountCents       Int
  dueDate           DateTime
  status            InvoiceStatus  @default(PENDING)
  method            PaymentMethod?
  paidAt            DateTime?
  gatewayFeeCents   Int?           // custo do gateway
  platformFeeCents  Int?           // taxa da plataforma (split)
  netCents          Int?           // líquido para o personal
  providerPaymentId String?        @unique
  paymentUrl        String?        // link de pagamento / Pix copia e cola
  manual            Boolean        @default(false) // recebido fora do app
  createdAt         DateTime       @default(now())
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription      StudentSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, status, dueDate])
}

enum LedgerType {
  INCOME
  EXPENSE
}

// Lançamentos financeiros (receitas do app + manuais + despesas futuras)
model LedgerEntry {
  id          String     @id @default(cuid())
  tenantId    String
  type        LedgerType
  category    String
  description String?
  amountCents Int
  date        DateTime
  invoiceId   String?
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    // "asaas"
  providerEventId String    @unique // idempotência
  type            String
  payload         Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())
}

// ───────────── Agenda ─────────────

enum SessionStatus {
  SCHEDULED
  DONE
  CANCELED
  MISSED
}

model ClassSession {
  id          String        @id @default(cuid())
  tenantId    String
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  online      Boolean       @default(false)
  status      SessionStatus @default(SCHEDULED)
  recurrence  String?       // RRULE para horários fixos
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([tenantId, startsAt])
}

model Attendance {
  id        String       @id @default(cuid())
  sessionId String
  studentId String
  present   Boolean?
  makeUp    Boolean      @default(false) // reposição
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

// ───────────── Treinos ─────────────

model Exercise {
  id          String   @id @default(cuid())
  tenantId    String?  // null = biblioteca global da plataforma
  name        String
  muscleGroup String?
  videoUrl    String?
  instructions String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       WorkoutItem[]
}

model Workout {
  id        String        @id @default(cuid())
  tenantId  String
  studentId String
  name      String        // "Treino A"
  notes     String?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items     WorkoutItem[]
  logs      WorkoutLog[]
}

model WorkoutItem {
  id          String   @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int
  sets        Int?
  reps        String?  // "8-12"
  load        String?
  restSeconds Int?
  notes       String?
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  workoutId   String
  completedAt DateTime @default(now())
  effort      Int?     // percepção de esforço 1-10
  comment     String?
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

// ───────────── Avaliações (dado sensível — LGPD) ─────────────

model Assessment {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  date        DateTime
  weightKg    Decimal? @db.Decimal(5, 2)
  bodyFatPct  Decimal? @db.Decimal(4, 1)
  measures    Json?    // { cintura: 80, quadril: 98, ... }
  photoKeys   String[] // chaves no storage privado
  notes       String?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, date])
}

// ───────────── Auditoria ─────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
